<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the lock-screen/notification-shade progress
  notification (§7). Android draws status-bar icons as a solid alpha mask —
  a single flat silhouette, no gradients, no color (the system tints it) —
  so this can't reuse the full-color launcher icon.

  Placeholder glyph: a simple road/path chevron, in the same spirit as the
  rest of the app's placeholder art (§9.1 — the real illustration source
  isn't chosen yet). Swap the path data once real art lands; the resource
  name and the 24x24dp/24x24 viewport convention stay the same.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,3 L21,20 L17.2,20 L12,10.3 L6.8,20 L3,20 Z" />
</vector>
