<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Health Connect (§3, §7) — read-only. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <!-- Classic Android runtime permission ("Physical activity" in system
         UI) that Health Connect's own STEPS permission additionally
         requires — health.requestAuthorization() only drives the Health
         Connect side, so features/steps/data/health_adapter.dart requests
         this one separately via permission_handler. Already reaches the
         merged manifest via a dependency's own manifest, but declared
         explicitly here for the same reason POST_NOTIFICATIONS is below:
         this app's manifest should say what it asks users for. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Health Connect's background-read permission (§7) — requested only
         when the user turns on the lock-screen/notification-shade display
         (`features/journey/presentation/lock_screen_controller.dart`), not
         as part of health onboarding. See docs/screens/lock-screen.md. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Android 13+ notification permission, requested by the same toggle
         (also declared transitively by workmanager_android, but kept
         explicit here for the same reason READ_STEPS/READ_DISTANCE above
         are — this app's own manifest should say what it asks users for,
         not rely on a dependency's manifest to say it for us). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="thereandback"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect requires the requesting app to be able to
                 show its own privacy-policy rationale before granting
                 health permissions — without this filter, Health Connect
                 can silently fail to recognize (or reject) our permission
                 request, independent of anything the user does in system
                 Settings. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Required by Health Connect so its own "manage app permissions"
             screen can deep-link back into this app (Android's
             android:permission="START_VIEW_PERMISSION_USAGE" is a
             system-signature permission held only by the OS/Health
             Connect, not something this app requests). Same requirement
             as the intent-filter above — part of the same Health Connect
             setup contract, see the `health` package's Android docs. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility so isHealthConnectAvailable()/installHealthConnect()
             (§7: Health Connect can be missing, handle it explicitly) can see it. -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Lets Health Connect verify this app can show a permissions
             rationale, part of the same setup contract as the
             ACTION_SHOW_PERMISSIONS_RATIONALE intent-filter on
             .MainActivity above. -->
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
